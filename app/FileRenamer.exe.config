<?xml version="1.0" encoding="utf-8"?>
<!--
  绿色版从 GitHub 下载 zip 解压后，文件会带上「来自互联网」标记(Zone.Identifier)。
  .NET Framework 出于安全默认拒绝 LoadFrom 这类程序集，pythonnet 载入
  Python.Runtime.dll 就会失败，启动报：
      Failed to resolve Python.Runtime.Loader.Initialize
  带上这个配置后可以直接加载，用户不必再手动右键「解除锁定」。
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
